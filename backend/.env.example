# Copy this file to `.env` and fill in your real values.
# The `.env` is gitignored; this example is committed so newcomers know
# exactly which variables the pipeline reads.

# ---- Database ----
DB_HOST=localhost
DB_PORT=56432
DB_NAME=rag
DB_USER=rag
DB_PASSWORD=**********
CHUNKS_TABLE=chunks

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text-v2-moe


# ---- Query rewriting (runs after Jev selects safe RAG, before retrieval) ----
# Tries to turn the user's question into a clearer single search query.
# QUERY_REWRITE_ENABLED=false  ->  skip the rewriter (no Ollama call)
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=minimax-m3:cloud

# ---- Retrieval and Jev reranker ----
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_TOP_N=20
RERANK_TOP_N=5

# ---- Generator (Ollama LLM) ----
GEN_MODEL=minimax-m3:cloud
GEN_TEMPERATURE=0.2
GEN_MAX_TOKENS=400

# ---- RAGAS judge LLM (must be a different model from GEN_MODEL) ----
JUDGE_MODEL=glm-4.7:cloud
JUDGE_TEMPERATURE=0.0

# ---- Jev gateway (OpenCode Zen) ----
# Set your OpenCode Zen API key. Empty key stops requests safely.
JEV_API_KEY=
JEV_API_URL=https://opencode.ai/zen/v1/systemone
JEV_MODEL=jev-1.13
JEV_TIMEOUT_SECONDS=10
# Block when request_block is strictly greater than this threshold (0..1).
JEV_BLOCK_THRESHOLD=0.5
# Short corpus description used by the request gateway. The reranker also sends
# retrieved candidate chunk text to Jev.
JEV_KB_DESCRIPTION=Kubernetes documentation: concepts, tasks, tutorials and reference material.
# Markdown instructions used for one Noul relevance question per candidate chunk.
JEV_RERANK_PROMPT_PATH=prompts/jev_reranker.md
