%% Jev adapter boundary and existing pipeline components.
classDiagram
    class GatewayProvider {
        <<interface>>
        +decide(query) GatewayDecision
    }
    class OpenCodeJevProvider {
        +decide(query) GatewayDecision
    }
    class GatewayDecision {
        +request_block: float
        +retrieval_route: RAG or DIRECT
    }
    class QueryService {
        +run(query, retrieve_only) QueryResult
    }
    class QueryResult {
        +request_id: str
        +status: str
        +route: str
        +jev_decision_ms: float
        +total_request_ms: float
    }
    class RerankedRetriever {
        +retrieve(query) tuple
    }
    class Generator {
        +generate(query, contexts) str
    }
    class DirectGenerator {
        +generate(query) str
    }
    OpenCodeJevProvider ..|> GatewayProvider
    GatewayProvider ..> GatewayDecision
    QueryService --> GatewayProvider
    QueryService ..> QueryResult
    QueryService --> RerankedRetriever : RAG only
    QueryService --> Generator : RAG only
    QueryService --> DirectGenerator : DIRECT only
    Generator --> build_llm : cached Ollama client
    DirectGenerator --> build_llm : same cached client
