%% Jev gateway decision tree. Filename retained for the diagram renderer.
flowchart TD
    Q([Original query]) --> J["POST Zen /v1/systemone<br/>request_block: Noul<br/>retrieval_route: Choice RAG or DIRECT"]
    J --> V{Validate both answers}
    V -- "failure" --> E["Service error; no downstream calls"]
    V -- "valid" --> B{Noul exceeds JEV_BLOCK_THRESHOLD?}
    B -- "yes" --> F["Safe refusal; no downstream calls"]
    B -- "no" --> R{Choice}
    R -- "RAG" --> A["Existing rewrite and RAG pipeline"]
    R -- "DIRECT" --> D["Ollama DIRECT prompt; no retrieval"]
    E --> L["Log request ID, outcome, route, failures<br/>jev_decision_ms and total_request_ms"]
    F --> L
    A --> L
    D --> L
