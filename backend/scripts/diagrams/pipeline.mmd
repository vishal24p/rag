%% Current request flow. Existing retrieval and RAG generation are unchanged.
flowchart TD
    Q([User query]) --> J["Jev through OpenCode Zen<br/>one request: request_block + retrieval_route<br/>query + short KB scope; no retrieved documents"]
    J --> VALID{Valid response?}
    VALID -- "timeout / invalid / provider failure" --> ERROR([Service error; stop])
    VALID -- "yes" --> BLOCK{request_block exceeds threshold?}
    BLOCK -- "yes" --> REFUSE([Safe refusal; stop])
    BLOCK -- "no" --> ROUTE{retrieval_route}
    ROUTE -- "RAG" --> REWRITE[Existing query rewrite]
    REWRITE --> DENSE[Dense pgvector]
    DENSE --> BM25[BM25]
    BM25 --> RRF[RRF]
    RRF --> RERANK[CrossEncoder]
    RERANK --> GEN[Existing RAG generator]
    ROUTE -- "DIRECT" --> DIRECT[Same Ollama client; separate DIRECT prompt]
    GEN --> OUT([Answer])
    DIRECT --> OUT
